{
  "name": "cora-ia",
  "productName": "CORA-IA",
  "version": "1.1.0",
  "description": "CORA-IA - asistente de IA conversacional con búsqueda en internet y micrófono desde el celular",
  "main": "main.js",
  "author": "Pedro",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "android": "cap sync android"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pedro.radexia",
    "productName": "CORA-IA",
    "files": [
      "main.js",
      "preload.js",
      "browser.js",
      "netproxy.js",
      "remote.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "valverdejpedro-rgb",
        "repo": "CORA-IA",
        "releaseType": "release"
      }
    ]
  }
}
